{
  "name": "ollaic",
  "version": "0.1.0",
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "prettier": "^3.9.5"
  },
  "private": true,
  "scripts": {
    "dev": "pnpm --dir design dev",
    "build": "pnpm --dir design build",
    "preview": "pnpm --dir design preview",
    "test": "pnpm --dir design test && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:ui": "pnpm --dir design test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "e2e:web": "pnpm --dir design e2e:web",
    "verify": "pnpm build && pnpm test",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "format:web": "prettier --write \"design/src/**/*.{ts,tsx,css,json,md}\"",
    "format:web:check": "prettier --check \"design/src/**/*.{ts,tsx,css,json,md}\"",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "format": "pnpm format:web && pnpm format:rust",
    "format:check": "pnpm format:web:check && pnpm format:rust:check"
  }
}
